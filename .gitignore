# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS / editors
.DS_Store
Thumbs.db
.vscode/
