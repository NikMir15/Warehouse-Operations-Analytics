# Generated data
# Keep .gitkeep placeholders, but avoid committing large/generated datasets by default.
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Power BI temp/cache files
*.pbit.tmp
~$*.pbix
